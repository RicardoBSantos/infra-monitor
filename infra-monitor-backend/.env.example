# Modelo de variaveis de ambiente do backend. Formato KEY=VALUE, sem aspas e sem
# "export": serve para systemd EnvironmentFile=, docker compose env_file: e `set -a; . ./.env`.
#
# O Spring NAO le este arquivo nem o .env: so enxerga variaveis do processo. Em producao
# quem injeta e o gerenciador do servico (ver README, "Variaveis de ambiente e .env").
# Valores abaixo servem apenas para desenvolvimento local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inframonitor
DB_USERNAME=inframonitor
DB_PASSWORD=inframonitor
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_SECRET=
JWT_ISSUER=infra-monitor
JWT_ACCESS_TOKEN_MINUTES=15
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Motor ICMP: ligar so na instancia unica que monitora.
MONITORING_ENGINE_ENABLED=false

# Telegram: DESLIGADO por padrao. Ligar e ato explicito e exige os dois flags em true,
# mais token e chat id. Com o token do grupo real aqui, qualquer boot com os flags em
# true envia alerta de verdade.
TELEGRAM_ENABLED=false
NOTIFICATION_DISPATCHER_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
