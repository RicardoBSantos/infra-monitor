<?xml version="1.0" encoding="utf-8"?>
<!-- Requires IIS Static Content, URL Rewrite 2 and ARR proxy enabled by an operator.
     Bind this site ONLY to its approved host name and HTTPS certificate.
     Health remains loopback-only; it is deliberately NOT proxied. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false"/>
    <staticContent>
      <remove fileExtension=".mjs"/>
      <mimeMap fileExtension=".mjs" mimeType="text/javascript"/>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="Strict-Transport-Security" value="max-age=31536000"/>
        <!-- CSP: the SPA, fonts, map GeoJSON and the MapLibre worker are all same-origin; there are no
             CDNs, tiles or eval. style-src keeps 'unsafe-inline' because Angular injects component
             <style> elements at runtime and static IIS cannot issue per-response nonces. The build
             disables critical-CSS inlining, whose onload handler script-src 'self' would block.
             img-src/worker-src allow data:/blob: used by the map and icons. -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"/>
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
        <add name="X-Frame-Options" value="DENY"/>
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()"/>
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env"/>
          <add segment=".git"/>
          <add segment="secrets"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Block private paths" stopProcessing="true">
          <match url="^(actuator|config|logs|staging|releases|package-manifest\.json)(/|$)" ignoreCase="true"/>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found"/>
        </rule>
        <rule name="HTTPS only" stopProcessing="true">
          <match url="(.*)"/>
          <conditions><add input="{HTTPS}" pattern="off" ignoreCase="true"/></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent"/>
        </rule>
        <rule name="Backend API" stopProcessing="true">
          <match url="^api/v1(/.*)?$"/>
          <action type="Rewrite" url="http://127.0.0.1:8080/api/v1{R:1}" appendQueryString="true"/>
        </rule>
        <rule name="Unknown API" stopProcessing="true">
          <match url="^api(/|$)"/>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found"/>
        </rule>
        <rule name="SPA routes" stopProcessing="true">
          <match url="^[^.]*$"/>
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$"/>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
          </conditions>
          <action type="Rewrite" url="/index.html"/>
        </rule>
      </rules>
      <outboundRules>
        <rule name="Fingerprinted assets" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*"/>
          <conditions><add input="{REQUEST_URI}" pattern="-[A-Z0-9]{8,}\.(js|css)(\?.*)?$" ignoreCase="true"/></conditions>
          <action type="Rewrite" value="public,max-age=31536000,immutable"/>
        </rule>
        <rule name="Unversioned static and HTML" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*"/>
          <conditions><add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true"/></conditions>
          <action type="Rewrite" value="no-store"/>
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <!-- Spring Security already sends X-Content-Type-Options and X-Frame-Options on proxied API
       responses; adding them again in IIS produced "nosniff, nosniff" (D-04). -->
  <location path="api">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Content-Type-Options"/>
          <remove name="X-Frame-Options"/>
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
