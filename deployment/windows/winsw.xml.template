<!-- MODEL ONLY: replace @@JAVA_EXE@@ and @@ROOT@@ with reviewed absolute paths, @@CORS_ALLOWED_ORIGINS@@
     with the exact HTTPS origin(s) served by IIS (comma-separated, no wildcard), e.g. https://<hostname>,
     and @@POSTGRESQL_SERVICE@@ with the PostgreSQL Windows service name.
     WinSW 2.12.0 x64/.NET Framework; executable supplied separately, never downloaded here. -->
<service>
  <id>InfraMonitorBackend</id>
  <name>Infra Monitor Backend</name>
  <description>Infra Monitor V1 - Java 21</description>
  <executable>@@JAVA_EXE@@</executable>
  <!-- Short tmpdir: on Windows, JDK 21 creates the NIO wakeup pipe as an AF_UNIX socket in tmpdir;
       a long TEMP path makes Tomcat fail with "Unable to establish loopback connection". -->
  <arguments>-Djava.io.tmpdir=@@ROOT@@\tmp\backend -Djdk.net.unixdomain.tmpdir=@@ROOT@@\tmp\backend -jar "@@ROOT@@\current\backend\app.jar" --spring.profiles.active=prod --server.address=127.0.0.1 --server.port=8080 --spring.flyway.enabled=false &quot;--spring.config.import=configtree:@@ROOT_URI@@/config/secrets/&quot; --spring.datasource.url=jdbc:postgresql://127.0.0.1:5432/${DB_NAME} --spring.datasource.username=${DB_USERNAME} --spring.datasource.password=${DB_PASSWORD} --app.auth.jwt.secret=${JWT_SECRET} --server.shutdown=graceful --spring.lifecycle.timeout-per-shutdown-phase=30s &quot;--logging.file.name=@@ROOT_URI@@/logs/backend/application.log&quot; --logging.logback.rollingpolicy.max-file-size=20MB --logging.logback.rollingpolicy.total-size-cap=192MB --logging.logback.rollingpolicy.max-history=7</arguments>
  <workingdirectory>@@ROOT@@\current\backend</workingdirectory>
  <env name="DB_HOST" value="127.0.0.1"/>
  <env name="DB_PORT" value="5432"/>
  <!-- Browsers send Origin on POST; without the published origin the API answers 403 "Invalid CORS request"
       and login fails (the default only allows the localhost dev server). -->
  <env name="CORS_ALLOWED_ORIGINS" value="@@CORS_ALLOWED_ORIGINS@@"/>
  <!-- D-05: must come back after a Windows restart. Delayed start plus an explicit dependency make the
       SCM start PostgreSQL first; replace @@POSTGRESQL_SERVICE@@ with its service name (e.g. postgresql-x64-16). -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>@@POSTGRESQL_SERVICE@@</depend>
  <serviceaccount>
    <domain>NT SERVICE</domain>
    <user>InfraMonitorBackend</user>
    <!-- false: WinSW 2.12 resolves the account before CreateService and fails (1332) for a virtual
         account that only exists once the service does; virtual accounts get the logon right implicitly. -->
    <allowservicelogon>false</allowservicelogon>
  </serviceaccount>
  <stoptimeout>45sec</stoptimeout>
  <onfailure action="restart" delay="30sec"/>
  <onfailure action="restart" delay="60sec"/>
  <!-- Keeps retrying (every 5 min after the first two failures) instead of staying down until someone notices. -->
  <onfailure action="restart" delay="300sec"/>
  <resetfailure>1hour</resetfailure>
  <logpath>@@ROOT@@\logs\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>2048</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
</service>
